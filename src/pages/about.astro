---
import Layout from "../layouts/Main.astro";
---

<Layout title="About Me">
<main class="bg-white text-[#0B3D2E]">

  <!-- Hero -->
  <section class="bg-[#0B3D2E] text-white py-20 px-6 text-center">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-6">
        About Premier Cleaning Uganda
      </h1>
      <p class="text-lg md:text-xl text-white/90">
        Your trusted partner for professional, affordable, and reliable cleaning services in Kampala and across Uganda.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn bg-white text-[#0B3D2E] border-none hover:bg-white/90">
          Get a Free Quote
        </a>
        <a href="/service" class="btn btn-outline text-white border-white hover:bg-white hover:text-[#0B3D2E]">
          View Our Services
        </a>
      </div>
    </div>
  </section>

  <!-- Introduction -->
  <section class="py-16 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-6">Clean Spaces. Comfortable Living.</h2>
      <p class="text-lg leading-relaxed">
        We believe a clean space does more than look good. It creates comfort, protects health, improves productivity, and gives you peace of mind. Whether it is your home, office, rental property, or commercial space, our experienced cleaning team is ready to make it spotless.
      </p>
    </div>
  </section>

  <!-- Who We Are -->
  <section class="py-16 px-6 bg-[#F4FBF8]">
    <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <h2 class="text-3xl font-bold mb-4">Who We Are</h2>
        <p class="mb-4">
          Premier Cleaning Uganda is a professional cleaning company dedicated to delivering high-quality cleaning solutions for homes, businesses, and institutions.
        </p>
        <p class="mb-4">
          We combine trained cleaners, modern cleaning methods, quality supplies, and a customer-first approach to deliver results you can see and feel.
        </p>
        <p>
          From routine house cleaning to deep cleaning, office cleaning, move-in/move-out cleaning, and post-construction cleaning, we tailor every service to meet your exact needs.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="card bg-[#0B3D2E] text-white shadow-lg">
          <div class="card-body items-center text-center">
            <h3 class="text-3xl font-bold">100%</h3>
            <p class="text-white/80">Trained Cleaning Team</p>
          </div>
        </div>

        <div class="card bg-white border border-[#0B3D2E]/20 shadow-lg">
          <div class="card-body items-center text-center">
            <h3 class="text-3xl font-bold text-[#0B3D2E]">24/7</h3>
            <p class="text-[#0B3D2E]/70">Flexible Booking Support</p>
          </div>
        </div>

        <div class="card bg-white border border-[#0B3D2E]/20 shadow-lg">
          <div class="card-body items-center text-center">
            <h3 class="text-3xl font-bold text-[#0B3D2E]">Affordable</h3>
            <p class="text-[#0B3D2E]/70">Transparent Pricing</p>
          </div>
        </div>

        <div class="card bg-[#0B3D2E] text-white shadow-lg">
          <div class="card-body items-center text-center">
            <h3 class="text-3xl font-bold">Reliable</h3>
            <p class="text-white/80">On-Time Service</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission and Vision -->
  <section class="py-16 px-6">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-6">
      <div class="card bg-[#0B3D2E] text-white shadow-xl">
        <div class="card-body">
          <h3 class="card-title text-2xl">Our Mission</h3>
          <p class="text-white/90">
            To provide exceptional cleaning services that create healthier, fresher, and more comfortable spaces for every client in Uganda.
          </p>
        </div>
      </div>

      <div class="card bg-white border border-[#0B3D2E]/20 shadow-xl">
        <div class="card-body">
          <h3 class="card-title text-2xl text-[#0B3D2E]">Our Vision</h3>
          <p class="text-[#0B3D2E]/80">
            To become Uganda’s most trusted and preferred cleaning company, known for professionalism, reliability, and outstanding customer care.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 px-6 bg-[#F4FBF8]">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-12">Why Clients Choose Us</h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="card bg-white shadow-md hover:shadow-xl transition">
          <div class="card-body">
            <div class="text-4xl mb-2">🧹</div>
            <h3 class="card-title text-[#0B3D2E]">Professional Cleaners</h3>
            <p class="text-[#0B3D2E]/80">
              Our cleaners are carefully selected, trained, and supervised to deliver consistent, high-quality results with care and attention to detail.
            </p>
          </div>
        </div>

        <div class="card bg-[#0B3D2E] text-white shadow-md hover:shadow-xl transition">
          <div class="card-body">
            <div class="text-4xl mb-2">⭐</div>
            <h3 class="card-title">Client Satisfaction First</h3>
            <p class="text-white/90">
              Your satisfaction is our priority. We listen, follow your instructions, and work diligently until your space meets our high standards.
            </p>
          </div>
        </div>

        <div class="card bg-white shadow-md hover:shadow-xl transition">
          <div class="card-body">
            <div class="text-4xl mb-2">🕒</div>
            <h3 class="card-title text-[#0B3D2E]">Flexible Scheduling</h3>
            <p class="text-[#0B3D2E]/80">
              Choose one-time, weekly, bi-weekly, monthly, or emergency cleaning appointments that fit your schedule.
            </p>
          </div>
        </div>

        <div class="card bg-white shadow-md hover:shadow-xl transition">
          <div class="card-body">
            <div class="text-4xl mb-2">💰</div>
            <h3 class="card-title text-[#0B3D2E]">Transparent Pricing</h3>
            <p class="text-[#0B3D2E]/80">
              Enjoy competitive rates with no hidden charges. You receive a clear quotation before any work begins.
            </p>
          </div>
        </div>

        <div class="card bg-[#0B3D2E] text-white shadow-md hover:shadow-xl transition">
          <div class="card-body">
            <div class="text-4xl mb-2">🧴</div>
            <h3 class="card-title">Quality Cleaning Supplies</h3>
            <p class="text-white/90">
              We use appropriate products and equipment to remove dirt, dust, stains, grease, and germs effectively.
            </p>
          </div>
        </div>

        <div class="card bg-white shadow-md hover:shadow-xl transition">
          <div class="card-body">
            <div class="text-4xl mb-2">🛡️</div>
            <h3 class="card-title text-[#0B3D2E]">Safe and Respectful Service</h3>
            <p class="text-[#0B3D2E]/80">
              We respect your privacy, handle your property carefully, and maintain professionalism from arrival to completion.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Satisfaction Promise -->
  <section class="py-16 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="card bg-[#0B3D2E] text-white shadow-2xl">
        <div class="card-body text-center py-12">
          <h2 class="text-3xl font-bold mb-4">Our Client Satisfaction Promise</h2>
          <p class="text-lg text-white/90 max-w-3xl mx-auto">
            We are not satisfied until you are. If any area does not meet your expectations, let us know and our team will make it right. Your comfort, trust, and peace of mind matter to us.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a href="/contact" class="btn bg-white text-[#0B3D2E] border-none hover:bg-white/90">
              Book a Cleaning Service
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-16 px-6 bg-[#F4FBF8]">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-10">Our Cleaning Services</h2>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="badge badge-lg bg-white text-[#0B3D2E] border border-[#0B3D2E]/20 p-4">House Cleaning</div>
        <div class="badge badge-lg bg-white text-[#0B3D2E] border border-[#0B3D2E]/20 p-4">Deep Cleaning</div>
        <div class="badge badge-lg bg-white text-[#0B3D2E] border border-[#0B3D2E]/20 p-4">Apartment Cleaning</div>
        <div class="badge badge-lg bg-white text-[#0B3D2E] border border-[#0B3D2E]/20 p-4">Office Cleaning</div>
        <div class="badge badge-lg bg-white text-[#0B3D2E] border border-[#0B3D2E]/20 p-4">Move-In and Move-Out Cleaning</div>
        <div class="badge badge-lg bg-white text-[#0B3D2E] border border-[#0B3D2E]/20 p-4">Post-Construction Cleaning</div>
        <div class="badge badge-lg bg-white text-[#0B3D2E] border border-[#0B3D2E]/20 p-4">Sofa and Carpet Cleaning</div>
        <div class="badge badge-lg bg-white text-[#0B3D2E] border border-[#0B3D2E]/20 p-4">Mattress Cleaning</div>
        <div class="badge badge-lg bg-white text-[#0B3D2E] border border-[#0B3D2E]/20 p-4">Window Cleaning</div>
        <div class="badge badge-lg bg-white text-[#0B3D2E] border border-[#0B3D2E]/20 p-4">Fumigation and Pest Control</div>
        <div class="badge badge-lg bg-white text-[#0B3D2E] border border-[#0B3D2E]/20 p-4">Commercial Cleaning</div>
        <div class="badge badge-lg bg-white text-[#0B3D2E] border border-[#0B3D2E]/20 p-4">Institutional Cleaning</div>
      </div>
    </div>
  </section>

  <!-- What Makes Us Different -->
  <section class="py-16 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-6">What Makes Us Different</h2>
      <p class="text-lg leading-relaxed text-[#0B3D2E]/80">
        At Premier Cleaning Uganda, we do not simply clean—we care for the spaces where our clients live, work, and grow. Our team arrives prepared, works efficiently, respects your privacy, and leaves every space fresh, tidy, and welcoming.
      </p>
      <p class="mt-4 text-lg text-[#0B3D2E]/80">
        We are committed to building long-term relationships through honesty, professionalism, and dependable service.
      </p>
    </div>
  </section>

  <!-- Areas We Serve -->
  <section class="py-16 px-6 bg-[#F4FBF8]">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-8">Areas We Serve</h2>

      <div class="flex flex-wrap justify-center gap-3">
        <span class="badge badge-lg bg-[#0B3D2E] text-white border-none p-4">Kampala</span>
        <span class="badge badge-lg bg-[#0B3D2E] text-white border-none p-4">Entebbe</span>
        <span class="badge badge-lg bg-[#0B3D2E] text-white border-none p-4">Wakiso</span>
        <span class="badge badge-lg bg-[#0B3D2E] text-white border-none p-4">Mukono</span>
        <span class="badge badge-lg bg-[#0B3D2E] text-white border-none p-4">Kira</span>
        <span class="badge badge-lg bg-[#0B3D2E] text-white border-none p-4">Nansana</span>
        <span class="badge badge-lg bg-[#0B3D2E] text-white border-none p-4">Najjera</span>
        <span class="badge badge-lg bg-[#0B3D2E] text-white border-none p-4">Ntinda</span>
        <span class="badge badge-lg bg-[#0B3D2E] text-white border-none p-4">Kololo</span>
        <span class="badge badge-lg bg-[#0B3D2E] text-white border-none p-4">Bugolobi</span>
        <span class="badge badge-lg bg-[#0B3D2E] text-white border-none p-4">Muyenga</span>
        <span class="badge badge-lg bg-[#0B3D2E] text-white border-none p-4">Munyonyo</span>
        <span class="badge badge-lg bg-white text-[#0B3D2E] border border-[#0B3D2E]/20 p-4">Other Surrounding Areas</span>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[#0B3D2E] text-white py-16 px-6 text-center">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Let’s Make Your Space Spotless</h2>
      <p class="text-lg text-white/90 mb-8">
        Whether you need a one-time deep clean or regular cleaning support, Premier Cleaning Uganda is ready to help.
      </p>
      <a href="/contact" class="btn bg-white text-[#0B3D2E] border-none btn-lg hover:bg-white/90">
        Contact Us Today
      </a>
    </div>
  </section>
</main>
</Layout>
